{
  "name": "l5e-basic-example",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=development tsx server.ts",
    "build": "vite build && vite build --ssr src/entry-server.ts --outDir dist/server && vite build --ssr server.ts --outDir dist --emptyOutDir false",
    "preview": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@l5e/core": "workspace:*",
    "esbuild": "^0.24.2",
    "rollup": "^4.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.5"
  }
}
